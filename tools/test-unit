sub test_util_htmlesc {
  assert(util::htmlesc('<script>&"x"') eq "&lt;script&gt;&amp;&quot;x&quot;",
         "htmlesc escapes special chars");
  assert(util::htmlesc(undef) eq "", "htmlesc undef returns empty");
  # Issue #774: apostrophes must be escaped for single-quoted attributes
  assert(util::htmlesc("Mikkeller's IPA") eq "Mikkeller&#39;s IPA",
         "htmlesc escapes apostrophe");
  assert(util::htmlesc(q{a'b"c}) eq "a&#39;b&quot;c",
         "htmlesc escapes apostrophe and double quote");
}

sub test_util_htmlunesc {
  assert(util::htmlunesc("Mikkeller&#39;s IPA") eq "Mikkeller's IPA",
         "htmlunesc decodes apostrophe entity");
  assert(util::htmlunesc("&lt;b&gt; &amp; &quot;q&quot; &#39;")
         eq q{<b> & "q" '}, "htmlunesc decodes all htmlesc entities");
  assert(util::htmlunesc(undef) eq "", "htmlunesc undef returns empty");
  # Round-trip with htmlesc, incl. a literal &amp; in the source text
  my $raw = q{Fish & Chips &amp; "O'Brien's" <ok>};
  assert(util::htmlunesc(util::htmlesc($raw)) eq $raw,
         "htmlunesc(htmlesc(x)) round-trips");
}

sub test_util_jssq {
  assert(util::jssq("It's") eq "It\\'s", "jssq escapes single quote");
  assert(util::jssq("a\\b") eq "a\\\\b", "jssq escapes backslash");
  assert(util::jssq("a\nb") eq "a\\nb", "jssq escapes newline");
  assert(util::jssq("a\rb") eq "a\\rb", "jssq escapes carriage return");
  assert(util::jssq("x</script>y") eq "x<\\/script>y",
         "jssq neutralizes closing script tag");
  assert(util::jssq(undef) eq "", "jssq undef returns empty");
}

# --- dateutil.pm ---

sub test_dateutil_effday {
  assert(dateutil::eff_day_of("2026-01-01 01:00:00") eq "2025-12-31",
         "eff_day_of before 6am = prev day");
  assert(dateutil::eff_day_of("2026-01-01 07:00:00") eq "2026-01-01",
         "eff_day_of after 6am = same day");
  assert(dateutil::eff_day_of("2026-01-01 05:59:59") eq "2025-12-31",
         "eff_day_of just before 6am cutoff");
  assert(dateutil::eff_day_of(undef) eq "", "eff_day_of undef returns empty");
}

sub test_dateutil_reldate {
  my $today = dateutil::datestr("%F", 0);
  my $yesterday = dateutil::datestr("%F", -1);
  assert(dateutil::reldate($today) eq "today", "reldate today");
  assert(dateutil::reldate($yesterday) eq "yesterday", "reldate yesterday");
  assert(dateutil::reldate("2020-01-01") eq "2020-01-01", "reldate passthrough");
}

sub test_dateutil_normalize {
  assert(dateutil::normalize_date({}, "") eq "", "normalize_date empty");
  assert(dateutil::normalize_date(undef, "Y") eq dateutil::datestr("%F", -1, 1),
         "normalize_date Y -> yesterday");
  assert(dateutil::normalize_date(undef, "-3d") eq dateutil::datestr("%F", -3, 1),
         "normalize_date -3d -> 3 days ago");
  assert(dateutil::normalize_date(undef, "2024-12-25") eq "2024-12-25",
         "normalize_date ISO passthrough");
}

sub test_dateutil_misc {
  # ts_epoch
  my $ep = dateutil::ts_epoch("2026-06-15 12:00:00");
  assert(defined $ep && $ep > 0, "ts_epoch returns numeric epoch");
  assert(!defined dateutil::ts_epoch(undef), "ts_epoch undef returns undef");
  assert(!defined dateutil::ts_epoch("bad"), "ts_epoch bad format returns undef");

  # date_plus_days
  assert(dateutil::date_plus_days("2026-01-01", 1) eq "2026-01-02",
         "date_plus_days +1");
  assert(dateutil::date_plus_days("2026-01-10", -5) eq "2026-01-05",
         "date_plus_days -5");

  # day_diff
  assert(dateutil::day_diff("2026-01-01", "2026-01-10") == 9, "day_diff forward");
  assert(dateutil::day_diff("2026-01-10", "2026-01-01") == -9, "day_diff backward");
  assert(dateutil::day_diff("2026-01-01", "2026-01-01") == 0, "day_diff same");
}

# --- geo.pm ---

sub test_geo_haversine {
  my $same = geo::haversineKm(55.6761, 12.5683, 55.6761, 12.5683);
  assert($same == 0, "haversineKm same point = 0");

  my $cp = geo::haversineKm(55.6761, 12.5683, 48.8566, 2.3522);
  assert($cp > 1000 && $cp < 1100, "haversineKm Copenhagen->Paris ~1027km ($cp)");

  # geodist formatting
  my $d0 = geo::geodist(55.6761, 12.5683, 55.6761, 12.5683);
  assert($d0 eq "0.000", "geodist same point = 0.000 (3 decimals)");

  my $d1 = geo::geodist(55.6761, 12.5683, 48.8566, 2.3522);
  assert($d1 =~ /^\d+$/, "geodist long distance = integer (0 decimals)");
}

