# --- postglass.pm / currencies ---

sub test_postglass_curprice {
  require postglass;
  my $c = { log => \*STDERR };

  # EUR shorthand
  my ($dkk, $orig) = postglass::curprice($c, "5.5e");
  assert(defined $dkk && $dkk == 41, "curprice 5.5e -> 41 DKK");

  # Full currency name (same conversion as shorthand)
  ($dkk, $orig) = postglass::curprice($c, "10eur");
  assert(defined $dkk && $dkk == 75, "curprice 10eur -> 75 DKK");

  # USD full name
  ($dkk, $orig) = postglass::curprice($c, "20usd");
  assert(defined $dkk && $dkk == 126, "curprice 20usd -> 126 DKK");

  # USD shorthand 'u' (documented in manual; needs currencies.pm alias merge)
  ($dkk, $orig) = postglass::curprice($c, "20u");
  assert(defined $dkk && $dkk == 126, "curprice 20u -> 126 DKK");

  # GBP shorthand
  ($dkk, $orig) = postglass::curprice($c, "8.5p");
  assert(defined $dkk && $dkk == 72, "curprice 8.5p -> 72 DKK");

  # GBP full name
  ($dkk, $orig) = postglass::curprice($c, "8.5gbp");
  assert(defined $dkk && $dkk == 72, "curprice 8.5gbp -> 72 DKK");

  # SEK shorthand
  ($dkk, $orig) = postglass::curprice($c, "100s");
  assert(defined $dkk && $dkk == 65, "curprice 100s -> 65 DKK");

  # SEK full name
  ($dkk, $orig) = postglass::curprice($c, "100sek");
  assert(defined $dkk && $dkk == 65, "curprice 100sek -> 65 DKK");

  # Case-insensitive aliases
  ($dkk, $orig) = postglass::curprice($c, "5.5E");
  assert(defined $dkk && $dkk == 41, "curprice 5.5E -> 41 DKK");
  ($dkk, $orig) = postglass::curprice($c, "10USD");
  assert(defined $dkk && $dkk == 63, "curprice 10USD -> 63 DKK");

  # Space between amount and currency (allowed by curprice pattern)
  ($dkk, $orig) = postglass::curprice($c, "5.5 e");
  assert(defined $dkk && $dkk == 41, "curprice '5.5 e' -> 41 DKK");

  # No currency suffix — should return empty list
  my @result = postglass::curprice($c, "45");
  assert(scalar(@result) == 0, "curprice '45' returns empty (no match)");

  # Unknown currency suffix — must not convert
  @result = postglass::curprice($c, "5.5xyz");
  assert(scalar(@result) == 0, "curprice '5.5xyz' returns empty (unknown currency)");

  # Empty string
  @result = postglass::curprice($c, "");
  assert(scalar(@result) == 0, "curprice '' returns empty");

  # Negative price with currency
  ($dkk, $orig) = postglass::curprice($c, "-5e");
  assert(defined $dkk && $dkk == -37, "curprice -5e -> -37 DKK");

  # --- Canonical note text (Part A: currencies.pm + always store ISO code) ---
  # Until currencies.pm lands these fail: today curprice stores the alias
  # as typed ("5.5 e" / "5.5 eur"), not the canonical code.

  ($dkk, $orig) = postglass::curprice($c, "5.5e");
  assert(defined $orig && $orig eq "5.5 EUR", "curprice 5.5e note is '5.5 EUR' (canonical)");

  ($dkk, $orig) = postglass::curprice($c, "5.5eur");
  assert(defined $orig && $orig eq "5.5 EUR", "curprice 5.5eur note is '5.5 EUR' (canonical)");

  # Shorthand and full name must produce the same stored note
  my (undef, $note_e)   = postglass::curprice($c, "5.5e");
  my (undef, $note_eur) = postglass::curprice($c, "5.5eur");
  assert(defined $note_e && defined $note_eur && $note_e eq $note_eur,
         "curprice 5.5e and 5.5eur produce the same note");

  ($dkk, $orig) = postglass::curprice($c, "20u");
  assert(defined $orig && $orig eq "20 USD", "curprice 20u note is '20 USD' (canonical)");

  ($dkk, $orig) = postglass::curprice($c, "20usd");
  assert(defined $orig && $orig eq "20 USD", "curprice 20usd note is '20 USD' (canonical)");

  ($dkk, $orig) = postglass::curprice($c, "8.5p");
  assert(defined $orig && $orig eq "8.5 GBP", "curprice 8.5p note is '8.5 GBP' (canonical)");

  ($dkk, $orig) = postglass::curprice($c, "100sek");
  assert(defined $orig && $orig eq "100 SEK", "curprice 100sek note is '100 SEK' (canonical)");
} # test_postglass_curprice

# --- mainlist.pm currency helpers (sumline totals) ---

sub test_mainlist_currency {
  # note_currency: parse [amount token] and normalise via currencies.pm
  my ($amt, $code) = mainlist::note_currency("nice [5.5 EUR]");
  assert(defined $amt && $amt == 5.5 && defined $code && $code eq "EUR",
         "note_currency canonical EUR");

  ($amt, $code) = mainlist::note_currency("old [8 e]");
  assert(defined $amt && $amt == 8 && defined $code && $code eq "EUR",
         "note_currency shorthand e -> EUR");

  ($amt, $code) = mainlist::note_currency("[10 usd]");
  assert(defined $amt && $amt == 10 && defined $code && $code eq "USD",
         "note_currency usd");

  ($amt, $code) = mainlist::note_currency("[4.5 GBP]");
  assert(defined $amt && $amt == 4.5 && defined $code && $code eq "GBP",
         "note_currency GBP");

  ($amt, $code) = mainlist::note_currency("[65 sek]");
  assert(defined $amt && $amt == 65 && defined $code && $code eq "SEK",
         "note_currency shorthand sek -> SEK");

  my @none = mainlist::note_currency("no currency here");
  assert(scalar(@none) == 0, "note_currency plain note returns empty");

  @none = mainlist::note_currency(undef);
  assert(scalar(@none) == 0, "note_currency undef returns empty");

  @none = mainlist::note_currency("[5.5 XYZ]");
  assert(scalar(@none) == 0, "note_currency unknown currency returns empty");

  # currency_total: pick dominant by count, then sum, then code
  my $glasses = [
    { note => "[5.5 EUR]" },
    { note => "[3 EUR]" },
    { note => "[2 USD]" },
  ];
  my $tot = mainlist::currency_total($glasses);
  assert(defined $tot && $tot->{code} eq "EUR" && $tot->{total} eq "8.50",
         "currency_total EUR wins on count (8.50)");

  $glasses = [
    { note => "[3 SEK]" },
    { note => "[2 SEK]" },
    { note => "[50 EUR]" },
  ];
  $tot = mainlist::currency_total($glasses);
  assert(defined $tot && $tot->{code} eq "SEK" && $tot->{total} eq "5.00",
         "currency_total more glasses wins over higher sum");

  $glasses = [
    { note => "[1 EUR]" },
    { note => "[5 USD]" },
  ];
  $tot = mainlist::currency_total($glasses);
  assert(defined $tot && $tot->{code} eq "USD" && $tot->{total} eq "5.00",
         "currency_total tie on count, higher sum wins");

  # Mixed aliases for the same code group together
  $glasses = [
    { note => "[5.5 e]" },
    { note => "[2.5 EUR]" },
    { note => "[1 p]" },
  ];
  $tot = mainlist::currency_total($glasses);
  assert(defined $tot && $tot->{code} eq "EUR" && $tot->{total} eq "8.00",
         "currency_total groups e and EUR");

  # Empty / no currency
  $tot = mainlist::currency_total([{ note => "just a beer" }, { note => undef }]);
  assert(!defined $tot, "currency_total undef when no currency notes");

  $tot = mainlist::currency_total([]);
  assert(!defined $tot, "currency_total undef for empty list");

  # currency_sumline_text — brackets + short symbols; drop trailing .00
  assert(mainlist::currency_sumline_text(undef) eq "",
         "currency_sumline_text undef -> empty");
  assert(mainlist::currency_sumline_text({ code => "EUR", total => "35.00" }) eq "[35\x{20AC}]",
         "currency_sumline_text EUR whole number drops decimals");
  assert(mainlist::currency_sumline_text({ code => "EUR", total => "8.50" }) eq "[8.5\x{20AC}]",
         "currency_sumline_text EUR keeps needed decimals");
  assert(mainlist::currency_sumline_text({ code => "USD", total => "5.00" }) eq "[5\$]",
         "currency_sumline_text USD uses dollar symbol");
  assert(mainlist::currency_sumline_text({ code => "GBP", total => "8.50" }) eq "[8.5\x{00A3}]",
         "currency_sumline_text GBP uses pound symbol");
  assert(mainlist::currency_sumline_text({ code => "SEK", total => "65.00" }) eq "[65SEK]",
         "currency_sumline_text SEK keeps code (no short symbol)");
} # test_mainlist_currency

# --- listrecords.pm ---

sub test_lr_suffixes {
  # Simple: auto width + link
  {
    my $r = listrecords::parse_field_suffixes(["Id_A_link=Brew"]);
    assert($r->{base}[0] eq "Id", "suffixes: Id_A_link=Brew base Id");
    assert($r->{suffix}[0]{auto_width} && $r->{suffix}[0]{link} eq "Brew",
           "suffixes: Id_A_link=Brew has auto_width and link=Brew");
    assert($r->{extra_attr}[0] eq "", "suffixes: Id_A_link=Brew no extra_attr");
  }
  # Stacked with rowspan side effect
  {
    my $r = listrecords::parse_field_suffixes(["Photo_R3_noheader_nofilter"]);
    assert($r->{base}[0] eq "Photo", "suffixes: Photo_R3_noheader_nofilter base Photo");
    assert($r->{suffix}[0]{rowspan} == 3, "suffixes: Photo_R3 rowspan 3");
    assert($r->{extra_attr}[0] eq "rowspan='3'", "suffixes: Photo_R3 extra_attr rowspan='3'");
    assert($r->{suffix}[0]{noheader} && $r->{suffix}[0]{nofilter},
           "suffixes: Photo_R3 has noheader and nofilter");
  }
  # Colspan + cont + auto
  {
    my $r = listrecords::parse_field_suffixes(["Name_A_C2_cont"]);
    assert($r->{base}[0] eq "Name", "suffixes: Name_A_C2_cont base Name");
    assert($r->{suffix}[0]{colspan} == 2, "suffixes: Name_A_C2_cont colspan 2");
    assert($r->{extra_attr}[0] eq "colspan='2'", "suffixes: Name_A_C2_cont extra_attr colspan='2'");
    assert($r->{suffix}[0]{cont} && $r->{suffix}[0]{auto_width},
           "suffixes: Name_A_C2_cont has cont and auto_width");
  }
  # Width override
  {
    my $r = listrecords::parse_field_suffixes(["LastSeen_90px"]);
    assert($r->{base}[0] eq "LastSeen", "suffixes: LastSeen_90px base LastSeen");
    assert($r->{px}{0} eq "90px", "suffixes: LastSeen_90px px override 90px");
  }
  # Aggregate stacking: last stripped wins (avg, not cnt)
  {
    my $r = listrecords::parse_field_suffixes(["Rate_avg_cnt_A"]);
    assert($r->{base}[0] eq "Rate", "suffixes: Rate_avg_cnt_A base Rate");
    assert($r->{suffix}[0]{aggregate} eq "avg", "suffixes: Rate_avg_cnt_A aggregate is avg (last wins)");
    assert($r->{suffix}[0]{auto_width}, "suffixes: Rate_avg_cnt_A auto_width");
  }
  # as= alias, value cannot contain underscores
  {
    my $r = listrecords::parse_field_suffixes(["LocationName_A_filter_as=LocName"]);
    assert($r->{base}[0] eq "LocationName", "suffixes: as= alias base LocationName");
    assert($r->{suffix}[0]{as_name} eq "LocName", "suffixes: as= alias as_name LocName");
    assert($r->{suffix}[0]{filter} && $r->{suffix}[0]{auto_width},
           "suffixes: as= alias also has filter and auto_width");
  }
  # contline vs cont
  {
    my $r = listrecords::parse_field_suffixes(["Last_A_contline"]);
    assert($r->{base}[0] eq "Last" && $r->{suffix}[0]{contline} && !$r->{suffix}[0]{cont},
           "suffixes: Last_A_contline is contline, not cont");
  }
  {
    my $r = listrecords::parse_field_suffixes(["Last_cont"]);
    assert($r->{base}[0] eq "Last" && $r->{suffix}[0]{cont} && !$r->{suffix}[0]{contline},
           "suffixes: Last_cont is cont");
  }
  # Unrecognized suffix: warn, do not strip
  {
    my $r = listrecords::parse_field_suffixes(["Foo_bar"]);
    assert($r->{base}[0] eq "Foo_bar", "suffixes: unrecognized suffix not stripped");
    assert(scalar(@{$r->{warnings}}) == 1, "suffixes: unrecognized suffix one warning");
    assert($r->{warnings}[0] =~ /'_bar'/ && $r->{warnings}[0] =~ /'Foo_bar'/,
           "suffixes: warning names the suffix and the original field");
  }
  # Mixed batch keeps per-column alignment
  {
    my $r = listrecords::parse_field_suffixes(["Name_A", "Photo_R2", "Alc", "Rate_avg"]);
    assert($r->{base}[0] eq "Name" && $r->{base}[1] eq "Photo"
           && $r->{base}[2] eq "Alc" && $r->{base}[3] eq "Rate",
           "suffixes: mixed batch bases aligned");
    assert($r->{suffix}[0]{auto_width} && !$r->{suffix}[2]{auto_width},
           "suffixes: mixed batch suffix flags aligned");
    assert($r->{extra_attr}[1] eq "rowspan='2'" && $r->{extra_attr}[0] eq "",
           "suffixes: mixed batch extra_attr aligned");
    assert($r->{suffix}[3]{aggregate} eq "avg", "suffixes: mixed batch Rate_avg aggregate avg");
  }
  # No suffix at all
  {
    my $r = listrecords::parse_field_suffixes(["Name", "Alc"]);
    assert($r->{base}[0] eq "Name" && $r->{base}[1] eq "Alc", "suffixes: plain names unchanged");
    assert(scalar(@{$r->{warnings}}) == 0, "suffixes: no warnings for plain names");
    assert(!%{$r->{px}} && !%{$r->{auto}}, "suffixes: no px/auto overrides for plain names");
  }
} # test_lr_suffixes
